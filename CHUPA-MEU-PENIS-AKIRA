local function playAudio(rawId)
	local cleanId = tostring(rawId):match("%d+")
	if not cleanId then
		AudioTitle.Text = "❌ Digite um ID numérico!"
		return
	end

	currentAudioId = cleanId
	AudioTitle.Text = "Tocando ID: " .. cleanId
	AudioAuthor.Text = "Por: Buscando..."
	CreatorAvatar.Image = "rbxassetid://0"

	LocalSound:Stop()
	LocalSound.SoundId = "rbxassetid://" .. cleanId
	LocalSound.Volume = saveData.Volume / 10
	LocalSound.PlaybackSpeed = saveData.Speed or 1
	LocalSound.TimePosition = 0

	LocalSound:Play()
	PlayInputBtn.Text = "Parar"
	PlayInputBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)

	task.spawn(function()
		local success, assetInfo = pcall(function()
			return MarketplaceService:GetProductInfo(tonumber(cleanId), Enum.InfoType.Asset)
		end)
		
		if success and assetInfo then
			currentAudioName = assetInfo.Name or ("Áudio " .. cleanId)
			AudioTitle.Text = currentAudioName
			
			local creatorData = assetInfo.Creator
			if creatorData then
				currentAudioCreator = creatorData.Name or "Roblox"
				AudioAuthor.Text = "Por: " .. currentAudioCreator
				
				local targetId = creatorData.CreatorTargetId or creatorData.TargetId or creatorData.Id
				local creatorType = creatorData.CreatorType
				
				if targetId and targetId > 0 then
					if creatorType == "User" then
						CreatorAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetId) .. "&w=420&h=420"
					elseif creatorType == "Group" then
						CreatorAvatar.Image = "rbxthumb://type=GroupIcon&id=" .. tostring(targetId) .. "&w=420&h=420"
					else
						CreatorAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetId) .. "&w=420&h=420"
					end
				end
			else
				AudioAuthor.Text = "Por: Roblox"
			end
		else
			AudioTitle.Text = "Áudio " .. cleanId
			AudioAuthor.Text = "Por: Desconhecido"
		end
		updateStarVisual()
	end)
end

