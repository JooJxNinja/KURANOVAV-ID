	saveData.Volume = volValue
	SliderFill.Size = UDim2.new(volValue / 10, 0, 1, 0)
	SliderBtn.Position = UDim2.new(volValue / 10, -7, 0.5, -7)
	SliderLabel.Text = string.format("Vol: [%02d/10]", volValue)
	LocalSound.Volume = volValue / 10
	saveSettings()
end

