local function loadSettings()
	if isfile and readfile and isfile(FILE_NAME) then
		pcall(function()
			local decoded = HttpService:JSONDecode(readfile(FILE_NAME))
			if type(decoded) == "table" then
				for k, v in pairs(decoded) do saveData[k] = v end
			end
		end)
	end
end

local function saveSettings()
	if writefile then
		pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(saveData)) end)
	end
end

