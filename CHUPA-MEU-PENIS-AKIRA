local function getBoomboxTrackId(character)
	local candidateIds = {}
	pcall(function()
		for _, obj in ipairs(character:GetDescendants()) do
			local foundRaw = nil
			if obj:IsA("Sound") and obj.SoundId ~= "" then
				foundRaw = obj.SoundId
			elseif obj:IsA("StringValue") or obj:IsA("IntValue") then
				if string.find(obj.Name:lower(), "track") or string.find(obj.Name:lower(), "sound") or string.find(obj.Name:lower(), "music") or string.find(obj.Name:lower(), "audio") then
					foundRaw = tostring(obj.Value)
				end
			end
			if foundRaw then
				local numOnly = string.match(foundRaw, "%d+")
				if numOnly and #numOnly >= 7 then table.insert(candidateIds, numOnly) end
			end
		end
	end)
	return (#candidateIds > 0) and candidateIds[1] or nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not isCopierEnabled then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local target = Mouse.Target
		if not target then return end
		
		local character = target:FindFirstAncestorOfClass("Model")
		if character and not Players:GetPlayerFromCharacter(character) then
			character = character:FindFirstAncestorOfClass("Model")
		end
		
		if character then
			local clickedPlayer = Players:GetPlayerFromCharacter(character)
			if clickedPlayer and clickedPlayer ~= LocalPlayer then
				local audioId = getBoomboxTrackId(character)
				if audioId then
					pcall(function()
						if setclipboard then setclipboard(audioId)
						elseif toclipboard then toclipboard(audioId) end
