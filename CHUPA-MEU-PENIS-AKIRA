RunService.Heartbeat:Connect(function(deltaTime)
	local loudness = LocalSound.IsPlaying and LocalSound.PlaybackLoudness or 0
	local normLoud = math.clamp(loudness / 400, 0, 1)

	for i, bar in ipairs(visBars) do
		local factor = math.sin((i / totalBars) * math.pi)
		local noise = math.sin(tick() * 12 + i * 0.4) * 0.2
		local targetH = math.clamp((normLoud * 38 * factor) + (normLoud * noise * 10), 4, 42)
		
		bar.Size = bar.Size:Lerp(UDim2.new(1/totalBars, -2, 0, targetH), 0.35)
		bar.Position = UDim2.new((i-1)/totalBars, 0, 1, -bar.Size.Y.Offset)
	end

	if LocalSound.IsPlaying and LocalSound.TimeLength > 0 then
		local progress = LocalSound.TimePosition / LocalSound.TimeLength
		ProgressDot.Position = UDim2.new(progress, -5, 0.5, -5)
		TimeLabel.Text = string.format("%02d:%02d / %02d:%02d", 
			math.floor(LocalSound.TimePosition/60), math.floor(LocalSound.TimePosition%60),
			math.floor(LocalSound.TimeLength/60), math.floor(LocalSound.TimeLength%60))
	else
		ProgressDot.Position = UDim2.new(0, -5, 0.5, -5)
		TimeLabel.Text = "00:00 / 00:00"
	end

	for userId, isMuted in pairs(mutedPlayers) do
		if isMuted then
			local plr = Players:GetPlayerByUserId(userId)
			if plr and plr.Character then
				for _, desc in ipairs(plr.Character:GetDescendants()) do
					if desc:IsA("Sound") and desc.Volume > 0 then desc.Volume = 0 end
				end
			end
		end
	end
end)

