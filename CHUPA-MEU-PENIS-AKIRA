local function checkAudioValidity(assetId)
	local success, info = pcall(function()
		return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
	end)
	if success and info and (info.AssetTypeId == 3 or info.AssetTypeId == 62) then
		return true, info
	end
	return false, nil
end

local function performWebSearch(query)
	for _, c in pairs(ResultsContainer:GetChildren()) do 
		if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end 
	end
	if query == "" then return end

	local StatusLbl = Instance.new("TextLabel")
	StatusLbl.Size = UDim2.new(1, 0, 0, 30)
	StatusLbl.BackgroundTransparency = 1
	StatusLbl.Font = Enum.Font.Gotham
	StatusLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
	StatusLbl.Text = "🔍 Buscando e filtrando IDs válidos..."
	StatusLbl.Parent = ResultsContainer

	task.spawn(function()
		local proxies = {
			"https://catalog.roproxy.com/v1/search/items?category=Audio&keyword=",
			"https://catalog.roblox.com/v1/search/items?category=Audio&keyword="
		}
		
		local response = nil
		local success = false
		
		for _, proxyBase in ipairs(proxies) do
			local url = proxyBase .. HttpService:UrlEncode(query) .. "&limit=15"
			local reqSuccess, reqRes = pcall(function() return game:HttpGet(url) end)
			if reqSuccess and reqRes and #reqRes > 10 then
				success = true
				response = reqRes
				break
			end
		end

		StatusLbl:Destroy()

		if success and response then
			local decodedSuccess, data = pcall(function() return HttpService:JSONDecode(response) end)
			if decodedSuccess and data and data.data then
				local validCount = 0
				
				for _, item in ipairs(data.data) do
					local assetId = item.id
					local isValid, assetInfo = checkAudioValidity(assetId)
					
					if isValid then
						validCount = validCount + 1
						
						local card = Instance.new("Frame")
