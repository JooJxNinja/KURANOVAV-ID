local function GetClosestPlayerToMe()
	local closestPlayer = nil
	local shortestDistance = math.huge
	
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = LocalPlayer.Character.HumanoidRootPart.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
			local targetHrp = player.Character.HumanoidRootPart
			local distance = (targetHrp.Position - myPos).Magnitude
			
			if distance < shortestDistance then
				shortestDistance = distance
				closestPlayer = player
			end
		end
	end
	return closestPlayer
end

local function isCharacterValid(player)
	return player and player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0
end

RunService.RenderStepped:Connect(function()
	if AimbotSystemActive and AimbotLockActive then
		if not CurrentAimbotTarget or not isCharacterValid(CurrentAimbotTarget) then
			CurrentAimbotTarget = GetClosestPlayerToCenter()
		end
		
		if CurrentAimbotTarget and CurrentAimbotTarget.Character then
			local targetPos = CurrentAimbotTarget.Character:FindFirstChild("Head") and CurrentAimbotTarget.Character.Head.Position or CurrentAimbotTarget.Character.HumanoidRootPart.Position
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
		end
	else
		CurrentAimbotTarget = nil
	end
	
	if ScanSystemActive and ScanLockActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		if not CurrentScanTarget or not isCharacterValid(CurrentScanTarget) then
			CurrentScanTarget = GetClosestPlayerToMe()
		end
		
		if CurrentScanTarget and CurrentScanTarget.Character and CurrentScanTarget.Character:FindFirstChild("HumanoidRootPart") then
			local myHrp = LocalPlayer.Character.HumanoidRootPart
			local targetHrp = CurrentScanTarget.Character.HumanoidRootPart
			local lookAtPosition = Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z)
			myHrp.CFrame = CFrame.new(myHrp.Position, lookAtPosition)
		end
	else
		CurrentScanTarget = nil
	end
end)
