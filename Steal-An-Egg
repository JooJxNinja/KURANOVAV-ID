        SaveConfig()
    end
end)

local isWindowAnimating = false
local isWindowOpen = false

local function ToggleWindow()
    if isWindowAnimating then return end
    isWindowAnimating = true

    PlayToggleSound()

    local targetPos = UDim2.new(
        Config.WindowPosition.XScale,
        Config.WindowPosition.XOffset + 190,
        Config.WindowPosition.YScale,
        Config.WindowPosition.YOffset + 145
    )

    if not isWindowOpen then
        NeonGlowBorder.Position = targetPos
        NeonGlowBorder.Size = UDim2.new(0, 0, 0, 0)
        NeonGlowBorder.Visible = true
        ToggleBtnContainer.Visible = IsMobile
        
        local openInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(NeonGlowBorder, openInfo, {
            Size = UDim2.new(0, 380, 0, 290)
        }):Play()

        task.wait(0.5)
        isWindowOpen = true
    else
        local closeInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        TweenService:Create(NeonGlowBorder, closeInfo, {
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()

        task.wait(0.4)
        NeonGlowBorder.Visible = false
        isWindowOpen = false
    end
    isWindowAnimating = false
end

local btnDragging = false
local btnDragStart = nil
local btnStartPos = nil
local movedDistance = 0

ToggleMenuBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = true
        btnDragStart = input.Position
        btnStartPos = ToggleBtnContainer.Position
        movedDistance = 0
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if btnDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - btnDragStart
        movedDistance = delta.Magnitude
        ToggleBtnContainer.Position = UDim2.new(
            btnStartPos.X.Scale,
            btnStartPos.X.Offset + delta.X,
            btnStartPos.Y.Scale,
            btnStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = false
    end
end)

ToggleMenuBtn.MouseButton1Click:Connect(function()
    if movedDistance < 5 then
        ToggleWindow()
    end
end)

