local function clearViewport3D()
    for _, object in ipairs(WorldModel3D:GetChildren()) do
        object:Destroy()
    end
end

local function getBoundingInfo(object)
    if object:IsA("Model") then
        local cf, size = object:GetBoundingBox()
        return cf, size
    elseif object:IsA("BasePart") then
        return object.CFrame, object.Size
    end

    local parts = {}
    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("BasePart") then
            table.insert(parts, descendant)
        end
    end

    if #parts == 0 then return nil, nil end

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge

    for _, part in ipairs(parts) do
        local p = part.Position
        local s = part.Size / 2
        minX = math.min(minX, p.X - s.X)
        minY = math.min(minY, p.Y - s.Y)
        minZ = math.min(minZ, p.Z - s.Z)
        maxX = math.max(maxX, p.X + s.X)
        maxY = math.max(maxY, p.Y + s.Y)
        maxZ = math.max(maxZ, p.Z + s.Z)
    end

    local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
    local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)

    return CFrame.new(center), size
end

local function cloneParasite(parasite)
    clearViewport3D()

    local clone
    if parasite:IsA("Model") or parasite:IsA("BasePart") then
        clone = parasite:Clone()
    else
        clone = Instance.new("Model")
        for _, descendant in ipairs(parasite:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local partClone = descendant:Clone()
                partClone.Parent = clone
            end
        end
    end

    if not clone then return end
    clone.Parent = WorldModel3D

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") or descendant:IsA("ProximityPrompt") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
        end
    end

    local cf, size = getBoundingInfo(clone)
    if not cf or not size then return end

    if clone:IsA("Model") then
        clone:PivotTo(CFrame.new(-cf.Position))
    elseif clone:IsA("BasePart") then
        clone.CFrame = CFrame.new(-cf.Position)
    end

    local largest = math.max(size.X, size.Y, size.Z)
    local distance = math.max(largest * 1.1, 2)

    ViewportCamera.CFrame = CFrame.lookAt(
        Vector3.new(0, size.Y * 0.15, distance),
        Vector3.new(0, 0, 0)
    )
end

local function scan3D()
    local area = Workspace:FindFirstChild(AREA_NAME)
    if not area then return end

    for _, container in ipairs(area:GetChildren()) do
        if container:IsA("Model") or container:IsA("Folder") then
            local parasite = container:FindFirstChild(PARASITE_NAME, true)
            local part = container:FindFirstChild(PART_NAME, true)
            if parasite and part then
                cloneParasite(parasite)
                break
            end
        end
    end
end

