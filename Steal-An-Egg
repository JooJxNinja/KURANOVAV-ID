local tabIndices = {
    [MainTabFrame] = 1,
    [CreditsTabFrame] = 2
}

local currentTab = MainTabFrame
local isTabAnimating = false

local function SwitchTab(targetFrame, targetBtn)
    if currentTab == targetFrame or isTabAnimating then return end
    isTabAnimating = true

    MainTabBtn.BackgroundColor3 = Color3.fromRGB(30, 10, 15)
    MainTabBtn.TextColor3 = Color3.fromRGB(150, 120, 125)
    CreditsTabBtn.BackgroundColor3 = Color3.fromRGB(30, 10, 15)
    CreditsTabBtn.TextColor3 = Color3.fromRGB(150, 120, 125)

    targetBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 30)
    targetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

    local currentIndex = tabIndices[currentTab]
    local targetIndex = tabIndices[targetFrame]
    
    local movingRight = targetIndex > currentIndex

    local targetStartPos = movingRight and UDim2.new(1, 0, 0, 0) or UDim2.new(-1, 0, 0, 0)
    local currentEndPos = movingRight and UDim2.new(-1, 0, 0, 0) or UDim2.new(1, 0, 0, 0)

    targetFrame.Position = targetStartPos
    targetFrame.Visible = true

    local tInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(currentTab, tInfo, {Position = currentEndPos}):Play()
    local mainTween = TweenService:Create(targetFrame, tInfo, {Position = UDim2.new(0, 0, 0, 0)})
    mainTween:Play()

    mainTween.Completed:Connect(function()
        if currentTab ~= targetFrame then
            currentTab.Visible = false
        end
        currentTab = targetFrame
        isTabAnimating = false
    end)
end

MainTabBtn.MouseButton1Click:Connect(function() SwitchTab(MainTabFrame, MainTabBtn) end)
