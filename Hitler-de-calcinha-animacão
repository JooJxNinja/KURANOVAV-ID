local tracks = {}
local keybinds = {}
local settingKeyForId = nil

local function levantar()
	humanoid.Sit = false
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
end

local function pararTodas()
	for _,info in pairs(tracks) do
		if info.tracks then
			for _,t in ipairs(info.tracks) do
				t:Stop()
			end
		end

		if info.cadeira then
			info.cadeira:Destroy()
		end

		if info.btn then
			info.btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		end
	end

	tracks = {}
	levantar()
end

local function playAnimString(idString, btn, nome)
	if tracks[btn] then
		for _, t in ipairs(tracks[btn].tracks) do
			t:Stop()
		end
		if tracks[btn].cadeira then
			tracks[btn].cadeira:Destroy()
		end
		levantar()
		btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		tracks[btn] = nil
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local ids = string.split(idString, "|")
	local activeTracks = {}
	local cadeira = nil

	if nome == "Chorando" or nome == "Agachar (Alt)" then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if hrp then
			cadeira = Instance.new("Seat")
			cadeira.Size = Vector3.new(2,1,2)
			cadeira.Transparency = 1
			cadeira.Anchored = true
			cadeira.CanCollide = false
			cadeira.CFrame = hrp.CFrame * CFrame.new(0,-2,0)
			cadeira.Parent = workspace

			humanoid.Sit = true
		end
	end

	for _, id in ipairs(ids) do
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://"..id
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		
		if nome == "BDB Staff" or nome == "Chorando" then
			track.Looped = false
			task.spawn(function()
				while track.Length == 0 do
					task.wait()
				end
				track:Play()
				task.wait(track.Length - 0.05)
				track:AdjustSpeed(0)
			end)
		elseif nome == "Beber" or nome == "Beber Anim" or nome == "Bater" or nome == "Golpe" then
			track.Looped = false
			track:Play()
			track.Stopped:Connect(function()
				btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
				if cadeira then
					cadeira:Destroy()
				end
				levantar()
				tracks[btn] = nil
			end)
		else
			track.Looped = true
			track:Play()
		end

		table.insert(activeTracks, track)
	end

	btn.BackgroundColor3 = Color3.fromRGB(80,80,255)
	tracks[btn] = {
		tracks = activeTracks,
		btn = btn,
		cadeira = cadeira
	}
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end

	if settingKeyForId then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			keybinds[input.KeyCode] = settingKeyForId
			settingKeyForId = nil
		end
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local animInfo = keybinds[input.KeyCode]
		if animInfo then
			playAnimString(animInfo.id, animInfo.btn, animInfo.nome)
		end
	end
end)

local function criarBotaoFlutuante(nome, id)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0,180,0,40)
	btn.Position = UDim2.new(0, math.random(50,400), 0, math.random(50,300))
	btn.Text = nome
	btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
	btn.TextColor3 = Color3.new(1,1,1)
	btn.Parent = gui
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,12)

	local moved = dragify(btn)

	btn.MouseButton1Click:Connect(function()
		if moved() then return end
		playAnimString(id, btn, nome)
	end)

	return btn
end

