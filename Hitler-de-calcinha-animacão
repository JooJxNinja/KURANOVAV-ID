local tracks = {}

local function playAnim(idString)
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local ids = string.split(idString, "|")
	local activeTracks = {}
	
	for _, id in ipairs(ids) do
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://"..id
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		track:Play()
		table.insert(activeTracks, track)
	end
	return activeTracks
end

for _, info in ipairs(animacoes) do
	local nome, id = info[1], info[2]
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 160, 0, 40)
	btn.Text = nome
	btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
	btn.TextColor3 = Color3.new(1,1,1)
	btn.Parent = scroll
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	
	btn.MouseButton1Click:Connect(function()
		if tracks[btn] then
			for _, t in ipairs(tracks[btn]) do t:Stop() end
			tracks[btn] = nil
			btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		else
			tracks[btn] = playAnim(id)
			btn.BackgroundColor3 = Color3.fromRGB(80,80,255)
		end
	end)
end

