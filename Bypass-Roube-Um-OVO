ToggleSpeedBtn.MouseButton1Click:Connect(function()
	SpeedActive = not SpeedActive
	if SpeedActive then
		ToggleSpeedBtn.Text = "Speed: ON"
		ToggleSpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
	else
		ToggleSpeedBtn.Text = "Speed: OFF"
		ToggleSpeedBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
