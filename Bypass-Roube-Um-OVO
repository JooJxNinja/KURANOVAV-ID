local playerTrapActive = false
local playerTrapConnection = nil
local processedTraps = {}

local function processTrap(trap)
	if processedTraps[trap] then return end
	local debris = workspace:FindFirstChild("__DEBRIS")
	if debris then
		local trapModel = debris:FindFirstChild("PlayerTrap")
		if trapModel and trapModel == trap then
			local hitbox = trapModel:FindFirstChild("Hitbox")
			if hitbox then
				if hitbox:IsA("BasePart") then
					hitbox.CanCollide = false
				end
			end
		end
	end
	processedTraps[trap] = true
end

local function scanAllTraps()
	local debris = workspace:FindFirstChild("__DEBRIS")
	if debris then
		for _, obj in ipairs(debris:GetDescendants()) do
			if obj.Name == "PlayerTrap" and not processedTraps[obj] then
				processTrap(obj)
			end
		end
	end
end

local function enablePlayerTrap()
	if playerTrapActive then return end
	playerTrapActive = true
	scanAllTraps()
	playerTrapConnection = workspace.DescendantAdded:Connect(function(child)
		if child.Name == "PlayerTrap" then
			local debris = workspace:FindFirstChild("__DEBRIS")
			if debris and child.Parent == debris then
				if not processedTraps[child] then
					processTrap(child)
				end
			end
		end
	end)
end

local function disablePlayerTrap()
	if not playerTrapActive then return end
	playerTrapActive = false
	if playerTrapConnection then
		playerTrapConnection:Disconnect()
		playerTrapConnection = nil
	end
end

