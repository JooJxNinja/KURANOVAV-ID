end)

if not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
	local KeybindContainer = Instance.new("Frame")
	KeybindContainer.Parent = MainFrame
	KeybindContainer.BackgroundTransparency = 1
	KeybindContainer.Size = UDim2.new(0, 280, 0, 42)
	KeybindContainer.LayoutOrder = 4

	local KeybindLabel = Instance.new("TextLabel")
	KeybindLabel.Parent = KeybindContainer
	KeybindLabel.BackgroundTransparency = 1
	KeybindLabel.Size = UDim2.new(0, 180, 0, 42)
	KeybindLabel.Font = Enum.Font.Gotham
	KeybindLabel.Text = "Tecla de Fechar:"
	KeybindLabel.TextColor3 = Color3.fromRGB(180, 180, 195)
	KeybindLabel.TextSize = 13
	KeybindLabel.TextXAlignment = Enum.TextXAlignment.Left

	local KeybindInput = Instance.new("TextButton")
	KeybindInput.Parent = KeybindContainer
	KeybindInput.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	KeybindInput.BorderSizePixel = 0
	KeybindInput.Position = UDim2.new(0, 190, 0, 0)
	KeybindInput.Size = UDim2.new(0, 90, 0, 42)
	KeybindInput.Font = Enum.Font.GothamBold
	KeybindInput.Text = "RightControl"
	KeybindInput.TextColor3 = Color3.fromRGB(255, 255, 255)
	KeybindInput.TextSize = 12

	local KeyCorner = Instance.new("UICorner")
	KeyCorner.CornerRadius = UDim.new(0, 8)
	KeyCorner.Parent = KeybindInput

	local selectedKey = Enum.KeyCode.RightControl
	local waitingForKey = false

	KeybindInput.MouseButton1Click:Connect(function()
		waitingForKey = true
		KeybindInput.Text = "..."
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if waitingForKey then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				selectedKey = input.KeyCode
				KeybindInput.Text = selectedKey.Name
				waitingForKey = false
			end
			return
		end
		
		if not gameProcessed and input.KeyCode == selectedKey then
			MainFrame.Visible = not MainFrame.Visible
		end
	end)
end

if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
	local FloatingBtn = Instance.new("TextButton")
	FloatingBtn.Name = "MobileToggleBtn"
	FloatingBtn.Parent = ScreenGui
	FloatingBtn.BackgroundColor3 = Color3.fromRGB(45, 125, 245)
	FloatingBtn.BorderSizePixel = 0
	FloatingBtn.Position = UDim2.new(0, 20, 0.4, 0)
	FloatingBtn.Size = UDim2.new(0, 50, 0, 50)
	FloatingBtn.Font = Enum.Font.GothamBold
	FloatingBtn.Text = "UI"
	FloatingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	FloatingBtn.TextSize = 16
	FloatingBtn.Draggable = true

	local FloatCorner = Instance.new("UICorner")
	FloatCorner.CornerRadius = UDim.new(1, 0)
	FloatCorner.Parent = FloatingBtn

	FloatingBtn.MouseButton1Click:Connect(function()
		MainFrame.Visible = not MainFrame.Visible
	end)
end

RunService.Heartbeat:Connect(function()
	if SpeedActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = LocalPlayer.Character.HumanoidRootPart
		local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		
		if humanoid and humanoid.MoveDirection.Magnitude > 0 then
			hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (TargetValueSpeed / 45))
		end
	end
end)
