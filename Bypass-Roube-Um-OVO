local lastPos = Vector3.new()
local lastTick = tick()

RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		
		if SpeedActive and humanoid and humanoid.MoveDirection.Magnitude > 0 then
			local moveVec = humanoid.MoveDirection * (TargetValueSpeed / 45)
			hrp.CFrame = hrp.CFrame + moveVec
			speedMovementAccumulator = speedMovementAccumulator + moveVec
		end
		
		local currentTick = tick()
		if currentTick - lastTick >= 0.4 then
			local deltaPos = hrp.Position - lastPos
			local externalDelta = deltaPos - speedMovementAccumulator
			if externalDelta.Magnitude > 45 then
				performBypass()
			end
			lastPos = hrp.Position
			lastTick = currentTick
			speedMovementAccumulator = Vector3.new(0,0,0)
		end
	end
end)
