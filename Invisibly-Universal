		charHighlight.Adornee = torso
		charHighlight.FillTransparency = 0.4
		charHighlight.OutlineTransparency = 0
		charHighlight.Parent = torso
	end
end

local function removeHighlight()
	if charHighlight then
		charHighlight:Destroy()
		charHighlight = nil
	end
end

