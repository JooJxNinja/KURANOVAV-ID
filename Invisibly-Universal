b.RenderStepped:Connect(function(dt)
	local offset = (tick() % 2) / 2
	mainGradient.Offset = Vector2.new(offset, 0)
	mobileOpenGradient.Offset = Vector2.new(offset, 0)

	local char = f.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end
	
	if showHighlight and S then
		if not charHighlight then
			applyHighlight(char)
		end
	else
		removeHighlight()
	end
	
	if S and upperPart and upperPart.Parent then
		local currentUpper = upperPart
		
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0 then
			currentUpper.CFrame = currentUpper.CFrame + (moveDir * currentSpeed * dt)
		end
		
		if verticalDirection ~= 0 then
			verticalTimer = verticalTimer + dt
			if verticalTimer >= VERTICAL_DURATION then
				verticalDirection = 0
				verticalTimer = 0
			else
				local verticalMovement = verticalDirection * VERTICAL_SPEED * dt
				currentUpper.CFrame = currentUpper.CFrame + Vector3.new(0, verticalMovement, 0)
			end
		end
		
		local camLook = h.CFrame.LookVector
		local targetPos = Vector3.new(currentUpper.Position.X, currentUpper.Position.Y, currentUpper.Position.Z)
		currentUpper.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(camLook.X, 0, camLook.Z))
		
		local targetPlayerPos = currentUpper.Position + Vector3.new(0, playerOffset, 0)
		root.CFrame = CFrame.new(targetPlayerPos, targetPlayerPos + Vector3.new(camLook.X, 0, camLook.Z))
		
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		
		h.CameraSubject = currentUpper
	else
		if h.CameraSubject == upperPart then
			h.CameraSubject = hum
		end
		if not S and upperPart then
			destroyUpperPart()
		end
	end
end)

