local function createPlayerCard(p)
	if p == LocalPlayer then return end
	
	local card = Instance.new("TextButton")
	card.Size = UDim2.new(1, 0, 0, 44)
	card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	card.BackgroundTransparency = 0.5
	card.BorderSizePixel = 0
	card.Text = ""
	card.ZIndex = 3
	card.Parent = PlayersScrolling
	
	local UICornerCard = Instance.new("UICorner")
	UICornerCard.CornerRadius = UDim.new(0, 6)
	UICornerCard.Parent = card
	
	-- UIStroke garante uma borda nítida que contrasta bem e aparece perfeitamente
	local cardStroke = Instance.new("UIStroke")
	cardStroke.Name = "CardStroke"
	cardStroke.Thickness = 1.5
	cardStroke.Color = Color3.fromRGB(60, 60, 60) -- Borda sutil quando não selecionado
	cardStroke.Parent = card
	
	local avatarImg = Instance.new("ImageLabel")
	avatarImg.Size = UDim2.new(0, 36, 0, 36)
	avatarImg.Position = UDim2.new(0, 4, 0.5, -18)
	avatarImg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	avatarImg.BackgroundTransparency = 1
	avatarImg.BorderSizePixel = 0
	avatarImg.ZIndex = 5
	avatarImg.Parent = card
	
	local UICornerAv = Instance.new("UICorner")
	UICornerAv.CornerRadius = UDim.new(0, 4)
	UICornerAv.Parent = avatarImg
	
	task.spawn(function()
		local thumbUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. p.UserId .. "&width=42&height=42&format=png"
		avatarImg.Image = thumbUrl
	end)
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -48, 0, 18)
	nameLabel.Position = UDim2.new(0, 46, 0, 5)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.SourceSansBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Text = p.DisplayName
	nameLabel.ZIndex = 4
	nameLabel.Parent = card
	
	local userLabel = Instance.new("TextLabel")
	userLabel.Size = UDim2.new(1, -48, 0, 16)
	userLabel.Position = UDim2.new(0, 46, 0, 22)
	userLabel.BackgroundTransparency = 1
	userLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
	userLabel.TextSize = 11
	userLabel.Font = Enum.Font.SourceSans
	userLabel.TextXAlignment = Enum.TextXAlignment.Left
	userLabel.Text = "@" .. p.Name
	userLabel.ZIndex = 4
	userLabel.Parent = card
	
	card.MouseButton1Click:Connect(function()
		selectedPlayer = p
		for _, item in pairs(playerItems) do
			if item.Card and item.Card.Parent then
				local stroke = item.Card:FindFirstChild("CardStroke")
				if stroke then
					stroke.Color = Color3.fromRGB(60, 60, 60)
					stroke.Thickness = 1.5
				end
			end
		end
		-- Borda destacada em destaque ao clicar
		if cardStroke then
			cardStroke.Color = Color3.fromRGB(255, 255, 255)
			cardStroke.Thickness = 2.5
		end
	end)
	
	playerItems[p] = {Card = card, Name = p.Name, Display = p.DisplayName}
end

for _, p in ipairs(Players:GetPlayers()) do
	createPlayerCard(p)
end

Players.PlayerAdded:Connect(function(p)
	createPlayerCard(p)
end)

Players.PlayerRemoving:Connect(function(p)
	if p == selectedPlayer then
		selectedPlayer = nil
		isActionActive = false
		ToggleButton.Text = "STATUS: OFF"
		ToggleButton.TextColor3 = Color3.fromRGB(255, 100, 100)
		if LocalPlayer.Character then
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				workspace.CurrentCamera.CameraSubject = hum
			end
		end
	end
	
	if playerItems[p] then
		if playerItems[p].Card then
			playerItems[p].Card:Destroy()
		end
		playerItems[p] = nil
	end
end)

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local filter = SearchBox.Text:lower()
	for p, item in pairs(playerItems) do
		if item.Card and item.Card.Parent then
			local matches = (p.Name:lower():find(filter) ~= nil) or (p.DisplayName:lower():find(filter) ~= nil) or tostring(p.UserId):find(filter) ~= nil
			item.Card.Visible = matches
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	local contentCount = 0
	for _, item in pairs(playerItems) do
		if item.Card and item.Card.Visible then
			contentCount = contentCount + 1
		end
	end
	PlayersScrolling.CanvasSize = UDim2.new(0, 0, 0, contentCount * 48)
	
	local rightCount = 0
	for _, child in ipairs(RightScrolling:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			rightCount = rightCount + child.AbsoluteSize.Y + 6
		end
	end
	RightScrolling.CanvasSize = UDim2.new(0, 0, 0, rightCount)
	
	if isActionActive and selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local myHrpt = char.HumanoidRootPart
			local targetHrpt = selectedPlayer.Character.HumanoidRootPart
			
			local targetHum = selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
			if targetHum then
				workspace.CurrentCamera.CameraSubject = targetHum
			end
			
			local speed = tonumber(speedInput.Text) or 10
			local dist = tonumber(distInput.Text) or 5
			
			local tPos = targetHrpt.Position
			local goalPos = tPos
			
			if selectedMode == "360°" then
				local tickVal = tick() * speed
				local offsetX = math.cos(tickVal) * dist
				local offsetZ = math.sin(tickVal) * dist
				goalPos = tPos + Vector3.new(offsetX, 0, offsetZ)
			elseif selectedMode == "Tp3" then
				local tickVal = (tick() * (speed * 0.5)) % 3
				local angle = math.floor(tickVal) * ((math.pi * 2) / 3)
				local offsetX = math.cos(angle) * dist
				local offsetZ = math.sin(angle) * dist
				goalPos = tPos + Vector3.new(offsetX, 0, offsetZ)
			elseif selectedMode == "Tp4" then
				local tickVal = (tick() * (speed * 0.5)) % 4
				local angle = math.floor(tickVal) * ((math.pi * 2) / 4)
				local offsetX = math.cos(angle) * dist
				local offsetZ = math.sin(angle) * dist
				goalPos = tPos + Vector3.new(offsetX, 0, offsetZ)
			end
			
			local currentPos = myHrpt.Position
			local vectorToGoal = goalPos - currentPos
			local distanceToGoal = vectorToGoal.Magnitude
			
			local travelSpeed = speed * 25
			local maxMoveThisFrame = travelSpeed * dt
			
			if distanceToGoal > maxMoveThisFrame then
				local nextPos = currentPos + (vectorToGoal.Unit * maxMoveThisFrame)
				myHrpt.CFrame = CFrame.new(nextPos, tPos)
			else
				myHrpt.CFrame = CFrame.new(goalPos, tPos)
			end
		end
	end
end)
