-- Sistema de Atalho PC (Tecla K) e Mobile (Segurar 3 dedos por 1 segundo)
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe then
        if input.KeyCode == Enum.KeyCode.K then
            MainFrame.Visible = not MainFrame.Visible
        elseif input.KeyCode == AimKey then
            AimbotEnabled = not AimbotEnabled
            AimbotBtn.Text = AimbotEnabled and "Aimbot: ON" or "Aimbot: OFF"
        end
    end
end)

local touchTask = nil
UserInputService.TouchStarted:Connect(function(_, processed)
    if processed then return end
    local activeTouches = UserInputService:GetTouches()
    if #activeTouches >= 3 then
        if touchTask then task.cancel(touchTask) end
        touchTask = task.delay(1, function()
            local currentTouches = UserInputService:GetTouches()
            if #currentTouches >= 3 then
                MainFrame.Visible = not MainFrame.Visible
            end
        end)
    end
end)

UserInputService.TouchEnded:Connect(function()
    local activeTouches = UserInputService:GetTouches()
    if #activeTouches < 3 and touchTask then
        task.cancel(touchTask)
        touchTask = nil
    end
end)

local currentTarget = nil

RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        if not currentTarget or not currentTarget.Parent or not currentTarget.Parent:FindFirstChild("Humanoid") or currentTarget.Parent.Humanoid.Health <= 0 then
            local closest = nil
            local dist = FOVRadius
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(TargetPart) then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToViewportPoint(p.Character[TargetPart].Position)
                        if onScreen then
                            local d = (Vector2.new(pos.X, pos.Y) - Camera.ViewportSize/2).Magnitude
                            if d < dist then
                                closest = p.Character[TargetPart]
                                dist = d
                            end
                        end
                    end
                end
            end
            currentTarget = closest
        end
        
        if currentTarget and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local head = LocalPlayer.Character:FindFirstChild("Head") or LocalPlayer.Character.HumanoidRootPart
            local targetPos = currentTarget.Position
            
            local currentDist = (Camera.CFrame.Position - head.Position).Magnitude
            if currentDist < 2 then currentDist = 10 end
            
            local lookVector = (targetPos - head.Position).Unit
            local newCamPos = head.Position - (lookVector * currentDist) + Vector3.new(0, 2, 0)
            
            Camera.CFrame = CFrame.new(newCamPos, targetPos)
        end
    else
        currentTarget = nil
    end
end)
