local function CreateTab(name)
    local btn = Instance.new("TextButton", Header)
    btn.Size = UDim2.new(0, 140, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = 0.4
