local fileName = "KURANOVAV_Bg.jpg"
local fileUrl = "https://raw.githubusercontent.com/JooJxNinja/KURANOVAV-ID/refs/heads/main/Screenshot_20260820_020242_Chrome.jpg"

local function loadBackgroundImage()
    if isfile and writefile and not isfile(fileName) then
        local success, response = pcall(function() return game:HttpGet(fileUrl) end)
        if success then writefile(fileName, response) end
    end
    return (getcustomasset and isfile(fileName)) and getcustomasset(fileName) or fileUrl
end

